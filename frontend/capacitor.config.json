{
  "appId": "com.billingeasy.app",
  "appName": "BillingsEasy",
  "webDir": "build",
  "android": {
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": false
  },
  "ios": {
    "contentInset": "always",
    "backgroundColor": "#ffffff",
    "scrollEnabled": true
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "backgroundColor": "#1d4ed8",
      "showSpinner": false,
      "launchAutoHide": true
    },
    "CapacitorHttp": {
      "enabled": false
    }
  }
}
